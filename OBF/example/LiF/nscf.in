&control
  calculation = 'nscf'
  prefix = 'system'
  pseudo_dir = './'
  outdir = './Out'
  wfcdir = 'undefined'
  tstress = .false.
  tprnfor = .true.
  wf_collect = .true.
  disk_io = 'low'
/
&system
  ibrav = 0
  nat = 2
  ntyp = 2
  noncolin = .false.
  lspinorb = .false.
  ecutwfc = 100
  occupations = 'fixed'
  smearing = 'gaussian'
  degauss = 0.002
  nspin  = 1
  tot_charge  = 0.0
  nosym = .true.
  noinv = .true.
  nbnd = 25
/
&electrons
  conv_thr = 1.0d-10
  mixing_beta = 0.7
  electron_maxstep = 50
  startingwfc = 'atomic+random'
  startingpot = 'file'
  diagonalization = 'david'
/
&ions
/
